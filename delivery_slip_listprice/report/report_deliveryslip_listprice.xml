<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Unit Price header (after serial/lot quantity column) -->
    <template id="delivery_add_unit_price_header"
              inherit_id="stock.report_delivery_document"
              priority="300">
        <xpath expr="//th[@name='th_sml_quantity']" position="after">
            <th class="text-end">
                <strong>Unit Price</strong>
            </th>
        </xpath>
    </template>

    <!-- Add Unit Price for aggregated rows (dict-based in Odoo 18) -->
    <template id="delivery_add_unit_price_aggregated"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines"
              priority="300">
        <xpath expr="//td[last()]" position="after">
            <td class="text-end">
                <span t-esc="formatLang(line['product'].list_price,
                                        monetary=True,
                                        currency_obj=o.company_id.currency_id)"/>
            </td>
        </xpath>
    </template>

    <!-- Add Unit Price for serial rows (move_line is a record) -->
    <template id="delivery_add_unit_price_serial"
              inherit_id="stock.stock_report_delivery_has_serial_move_line"
              priority="300">
        <xpath expr="//td[last()]" position="after">
            <td class="text-end">
                <span t-field="move_line.product_id.list_price"
                      t-options="{'widget': 'monetary',
                                  'display_currency': o.company_id.currency_id}"/>
            </td>
        </xpath>
    </template>

    <!-- Grand total under the Done moves table -->
    <template id="delivery_add_total"
              inherit_id="stock.report_delivery_document"
              priority="300">
        <xpath expr="//table[@name='stock_move_line_table']" position="after">
            <div class="text-end mt-2">
                <t t-set="total_price"
                   t-value="sum(l.product_id.list_price * l.qty_done for l in o.move_line_ids)"/>
                <strong>Total: </strong>
                <span t-esc="formatLang(total_price, monetary=True, currency_obj=o.company_id.currency_id)"/>
            </div>
        </xpath>
    </template>

</odoo>
